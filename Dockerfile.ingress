FROM golang:1.26.7-alpine3.24 AS build

ARG CADDY_VERSION=2.11.4
WORKDIR /src
ENV GOSUMDB=sum.golang.org

# Build a tiny external main module so the Caddy dependency is recorded in
# Go build metadata as the real release version. Trivy can then validate the
# patched binary without treating an exact source checkout as a pseudo-version.
RUN printf '%s\n' \
      'package main' \
      '' \
      'import (' \
      '    _ "time/tzdata"' \
      '    caddycmd "github.com/caddyserver/caddy/v2/cmd"' \
      '    _ "github.com/caddyserver/caddy/v2/modules/standard"' \
      ')' \
      '' \
      'func main() { caddycmd.Main() }' \
      > main.go \
    && go mod init flashin-ingress \
    && go get \
      "github.com/caddyserver/caddy/v2@v${CADDY_VERSION}" \
      golang.org/x/crypto@v0.55.0 \
      golang.org/x/net@v0.57.0 \
      golang.org/x/text@v0.41.0 \
      google.golang.org/grpc@v1.82.1 \
    && go mod tidy \
    && go mod verify \
    && go list -m -f '{{.Path}} {{.Version}}' all | grep -Fx "github.com/caddyserver/caddy/v2 v${CADDY_VERSION}" \
    && go list -m -f '{{.Path}} {{.Version}}' all | grep -Fx 'golang.org/x/crypto v0.55.0' \
    && go list -m -f '{{.Path}} {{.Version}}' all | grep -Fx 'golang.org/x/net v0.57.0' \
    && go list -m -f '{{.Path}} {{.Version}}' all | grep -Fx 'golang.org/x/text v0.41.0' \
    && go list -m -f '{{.Path}} {{.Version}}' all | grep -Fx 'google.golang.org/grpc v1.82.1' \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/caddy . \
    && go version -m /out/caddy | grep -E "github.com/caddyserver/caddy/v2[[:space:]]+v${CADDY_VERSION}" \
    && go version -m /out/caddy | grep -E 'golang.org/x/crypto[[:space:]]+v0\.55\.0' \
    && go version -m /out/caddy | grep -E 'golang.org/x/net[[:space:]]+v0\.57\.0' \
    && go version -m /out/caddy | grep -E 'golang.org/x/text[[:space:]]+v0\.41\.0'

FROM alpine:3.24.1
# The base tag can lag patched packages published to the Alpine 3.24
# repository. Require the OpenSSL revision that fixes CVE-2026-14456 rather
# than suppressing the image scanner finding or relying on a mutable tag pull.
RUN apk add --no-cache \
      'libcrypto3>=3.5.8-r0' \
      'libssl3>=3.5.8-r0' \
      ca-certificates \
    && mkdir -p /config/caddy /data/caddy /etc/caddy /srv \
    && chmod 1777 /config/caddy /data/caddy
COPY --from=build /out/caddy /usr/bin/caddy

ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data
WORKDIR /srv
EXPOSE 80 443 443/udp 2019
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
