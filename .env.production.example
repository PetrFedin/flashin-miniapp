APP_ENV=production
POSTGRES_DB=flashin
POSTGRES_USER=flashin
POSTGRES_PASSWORD=STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg2://flashin:STRONG_PASSWORD@db:5432/flashin
CORS_ORIGINS=https://mini.flashin.store,https://admin.flashin.store

TELEGRAM_BOT_TOKEN=
BOT_TOKEN=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200
ADMIN_JWT_EXPIRE_MINUTES=480

NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_POLL_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_INITIAL_BACKOFF_SECONDS=30
NOTIFICATION_MAX_BACKOFF_SECONDS=3600
NOTIFICATION_LEASE_SECONDS=180

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOTP_ENCRYPTION_KEY=

MINI_APP_URL=https://mini.flashin.store
API_PUBLIC_URL=https://api.flashin.store
ADMIN_URL=https://admin.flashin.store

PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://mini.flashin.store/payment-result

MEDIA_STORAGE=r2
MEDIA_PUBLIC_BASE_URL=https://cdn.flashin.store
MEDIA_LOCAL_DIR=media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

USE_CREATE_ALL=false
ENABLE_SEED=false

MEILISEARCH_ENABLED=true
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_PRODUCTS_INDEX=products

MOYSKLAD_BASE_URL=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_TOKEN=
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=
MOYSKLAD_DEFAULT_CURRENCY=RUB
MOYSKLAD_SALE_PRICE_TYPE=Розничная цена
MOYSKLAD_SIZE_ATTRIBUTE_NAMES=Размер,Size
MOYSKLAD_COLOR_ATTRIBUTE_NAMES=Цвет,Color
MOYSKLAD_SYNC_LIMIT=100
MOYSKLAD_SYNC_INTERVAL_MINUTES=30

SENTRY_DSN=
METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=10
OUTBOX_SIGNING_SECRET=
FEATURE_FLAGS_ENABLED=true
SCHEDULER_ENABLED=true
MEDIA_GENERATE_WEBP=true
MEDIA_GENERATE_THUMBNAILS=true
MEDIA_THUMBNAIL_WIDTH=480
RECOMMENDATION_PERSONAL_LIMIT=12
IMPORT_EXPORT_DIR=exports

# Pilot evidence and admission. Use a dedicated random secret; do not reuse JWT/TOTP/outbox keys.
PILOT_EVIDENCE_SIGNING_SECRET=
PILOT_PROVIDER_EVIDENCE_MAX_AGE_MINUTES=60
PILOT_LIVE_GATE_MAX_AGE_MINUTES=30
PILOT_ADMISSION_MAX_AGE_MINUTES=60
PILOT_ROLLBACK_DRILL_MAX_AGE_DAYS=30

# Production checkout remains closed until the signed pilot runtime is armed.
PILOT_RUNTIME_ENFORCED=true
PILOT_RUNTIME_MAX_ORDERS=20
