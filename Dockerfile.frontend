FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json /app/package.json
RUN npm install
COPY frontend /app
ARG VITE_API_BASE=http://localhost:8000
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM alpine:3.24.1
RUN addgroup -S flashin && adduser -S -G flashin flashin
COPY --from=build --chown=flashin:flashin /app/dist /srv
USER flashin
EXPOSE 5173
CMD ["busybox", "httpd", "-f", "-p", "5173", "-h", "/srv"]
