(security_headers) {
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Permitted-Cross-Domain-Policies "none"
    }
}

(access_log) {
    log {
        output stdout
        format json
    }
}

mini.flashin.store {
    import security_headers
    import access_log

    encode gzip zstd
    header X-Frame-Options "SAMEORIGIN"
    reverse_proxy frontend:5173
}

admin.flashin.store {
    import security_headers
    import access_log

    encode gzip zstd
    header {
        X-Frame-Options "DENY"
        Cache-Control "no-store"
    }
    reverse_proxy admin:5174
}

api.flashin.store {
    import security_headers
    import access_log

    @internal_only path /metrics /docs /docs/* /redoc /redoc/* /openapi.json
    respond @internal_only 404

    encode gzip zstd
    request_body {
        max_size 20MB
    }
    header {
        X-Frame-Options "DENY"
        Cache-Control "no-store"
    }
    reverse_proxy backend:8000 {
        # The pilot has one public ingress hop. Never relay a client-supplied
        # forwarding chain to the application: publish exactly the socket peer
        # Caddy accepted and remove the alternate X-Real-IP input entirely.
        header_up X-Forwarded-For {remote_host}
        header_up -X-Real-IP
    }
}
