{
  "title": "FLASHIN Fulfillment SLA",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "SLA overdue",
      "targets": [
        {
          "expr": "sum(flashin_sla_overdue_total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fulfillment backlog",
      "targets": [
        {
          "expr": "sum(flashin_fulfillment_open_total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "MoySklad conflicts",
      "targets": [
        {
          "expr": "sum(flashin_moysklad_conflicts_total)"
        }
      ]
    }
  ]
}