{
  "title": "FLASHIN Payments",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Payment webhook HTTP errors",
      "targets": [
        {
          "expr": "sum(rate(flashin_http_requests_total{path=~'.*webhook.*',status=~'5..|4..'}[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Payment reconciliation open",
      "targets": [
        {
          "expr": "sum(flashin_payment_reconciliation_open_total)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Payment latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(flashin_http_request_latency_seconds_bucket{path=~'.*payments.*'}[5m])) by (le))"
        }
      ]
    }
  ]
}