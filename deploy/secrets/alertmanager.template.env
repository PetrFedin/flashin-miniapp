# Copy to deploy/secrets/alertmanager.env and set mode 0600.
# Keep this secret outside the application .env so it is not passed to app containers.
ALERTMANAGER_WEBHOOK_URL=https://replace.example.invalid/alertmanager
ALERTMANAGER_ONCALL_OWNER=REPLACE_WITH_NAMED_ONCALL_OWNER
ALERTMANAGER_SEND_RESOLVED=true
